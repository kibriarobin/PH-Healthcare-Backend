<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Doctor Application Update</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f5f7fa; font-family: Arial, Helvetica, sans-serif;">

  <div style="max-width: 600px; margin: 40px auto; background-color: #ffffff; border-radius: 10px; overflow: hidden;">

    <!-- Header -->
    <div style="background-color: #2563eb; padding: 25px; text-align: center;">
      <h1 style="margin: 0; color: #ffffff;">
        PH Healthcare
      </h1>
    </div>

    <!-- Content -->
    <div style="padding: 30px;">

      <h2 style="color: #1f2937;">
        Hello, <%= doctorName %>
      </h2>

      <p style="color: #4b5563; font-size: 16px; line-height: 1.6;">
        Thank you for your interest in joining
        <strong>PH Healthcare</strong> as a doctor.
      </p>

      <p style="color: #4b5563; font-size: 16px; line-height: 1.6;">
        After carefully reviewing your application, we regret to inform you
        that your doctor application has not been approved at this time.
      </p>

      <!-- Application Info -->
      <div style="background-color: #f3f4f6; padding: 20px; border-radius: 8px; margin: 20px 0;">

        <p style="margin: 8px 0;">
          <strong>Name:</strong> <%= doctorName %>
        </p>

        <p style="margin: 8px 0;">
          <strong>Email:</strong> <%= doctorEmail %>
        </p>

        <% if (specialization) { %>
          <p style="margin: 8px 0;">
            <strong>Specialization:</strong> <%= specialization %>
          </p>
        <% } %>

      </div>

      <% if (rejectionReason) { %>
        <div style="background-color: #fef2f2; border-left: 4px solid #ef4444; padding: 15px; margin: 20px 0;">
          <p style="margin: 0 0 8px; color: #991b1b;">
            <strong>Reason for Rejection</strong>
          </p>

          <p style="margin: 0; color: #4b5563; line-height: 1.6;">
            <%= rejectionReason %>
          </p>
        </div>
      <% } %>

      <p style="color: #4b5563; font-size: 15px; line-height: 1.6;">
        We appreciate your time and effort in submitting your application.
        You may review the requirements and apply again in the future if
        eligible.
      </p>

      <p style="color: #374151; margin-top: 25px; line-height: 1.6;">
        Best regards,<br />
        <strong>PH Healthcare Team</strong>
      </p>

    </div>

    <!-- Footer -->
    <div style="background-color: #f9fafb; padding: 15px; text-align: center;">
      <p style="margin: 0; color: #9ca3af; font-size: 12px;">
        © <%= new Date().getFullYear() %> PH Healthcare
      </p>
    </div>

  </div>

</body>
</html>